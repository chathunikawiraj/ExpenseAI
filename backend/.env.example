PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Use Neon's direct (non-pooler) connection URL for Prisma migrations.
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173

# Optional in development: without Cloudinary, validated files use backend/uploads.
# Production requires all three values and stores receipts as authenticated assets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail: enable 2-Step Verification and create an App Password.
# Use the App Password here, not your Gmail account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="ExpenseAI <your-gmail-address@gmail.com>"
