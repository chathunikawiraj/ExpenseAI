{
  "info": {
    "_postman_id": "d47c83a1-4d93-4f08-a2eb-5b9c9b9f1d6a",
    "name": "ExpenseAI - Expense Management",
    "description": "Expense CRUD, category validation, authentication, user isolation, search, date filters, sorting, and pagination. Set the primary and secondary credentials to verified accounts before running the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "" },
    { "key": "otherEmail", "value": "" },
    { "key": "otherPassword", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "otherAccessToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "expenseId", "value": "" },
    { "key": "testDate", "value": "" },
    { "key": "categoryName", "value": "" }
  ],
  "item": [
    {
      "name": "Login as primary user",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Primary user login succeeds', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('accessToken', body.accessToken);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login as second user (isolation test)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{otherEmail}}\",\n  \"password\": \"{{otherPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Second user login succeeds', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('otherAccessToken', body.accessToken);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Expenses reject unauthenticated requests",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "url": "{{baseUrl}}/expenses"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expense endpoint requires authentication', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create test category",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('categoryName', 'Expense API Test ' + pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('testDate', new Date().toISOString().slice(0, 10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Test category is created', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.category.id).to.be.a('string');",
              "  pm.collectionVariables.set('categoryId', body.data.category.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{categoryName}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/categories"
      }
    },
    {
      "name": "Create expense",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Grocery {{categoryName}}\",\n  \"amount\": 42.75,\n  \"date\": \"{{testDate}}\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"paymentMethod\": \"CASH\",\n  \"description\": \"Collection CRUD test\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/expenses"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expense is created with the selected category', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.amount).to.eql(42.75);",
              "  pm.expect(body.categoryId).to.eql(pm.collectionVariables.get('categoryId'));",
              "  pm.collectionVariables.set('expenseId', body.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject expense with unavailable category",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Invalid category check\",\n  \"amount\": 10,\n  \"date\": \"{{testDate}}\",\n  \"categoryId\": \"00000000-0000-4000-8000-000000000000\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/expenses"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expense with unavailable category is rejected', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().code).to.eql('INVALID_CATEGORY');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List expenses with search, date, category, sort, and page filters",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/expenses?search=Postman&categoryId={{categoryId}}&startDate={{testDate}}&endDate={{testDate}}&sortBy=amount&sortOrder=desc&page=1&limit=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Filtered expense list includes pagination metadata', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.data).to.be.an('array');",
              "  pm.expect(body.data.some(function (expense) { return expense.id === pm.collectionVariables.get('expenseId'); })).to.eql(true);",
              "  pm.expect(body.meta).to.include({ page: 1, limit: 10 });",
              "  pm.expect(body.meta.total).to.be.at.least(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Read created expense",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/expenses/{{expenseId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expense can be retrieved by ID', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('expenseId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Other user cannot read expense",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{otherAccessToken}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/expenses/{{expenseId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('A different authenticated user receives not found', function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update expense",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 45.25,\n  \"description\": \"Updated by Postman\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/expenses/{{expenseId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expense fields are updated', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.amount).to.eql(45.25);",
              "  pm.expect(body.description).to.eql('Updated by Postman');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete expense",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "DELETE",
        "url": "{{baseUrl}}/expenses/{{expenseId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expense is deleted', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Deleted expense returns not found",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/expenses/{{expenseId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deleted expense is no longer available', function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete test category",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
        },
        "method": "DELETE",
        "url": "{{baseUrl}}/categories/{{categoryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unused test category is cleaned up', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
