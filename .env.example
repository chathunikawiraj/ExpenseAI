# Server Environment Variables
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_DB_PASSWORD@localhost:5432/expenseai?schema=public"
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary Storage (falls back to local uploads/ directory)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: OpenAI API for Smart Insights (falls back to rule-based engine)
OPENAI_API_KEY=

# Client Environment Variables
VITE_API_BASE_URL=http://localhost:5000/api/v1
