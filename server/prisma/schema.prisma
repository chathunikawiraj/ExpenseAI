// Prisma schema for ExpenseAI (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  OTHER
}

enum RecurringFrequency {
  NONE
  WEEKLY
  MONTHLY
}

enum InsightSource {
  AI
  RULE
}

enum OcrStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  passwordHash   String
  role           Role           @default(USER)
  currency       String         @default("USD")
  monthlyIncome  Decimal        @default(0.00) @db.Decimal(12, 2)
  isVerified     Boolean        @default(false)
  verificationToken String?
  resetToken     String?
  resetExpiresAt DateTime?
  status         UserStatus     @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  refreshTokens  RefreshToken[]
  incomes        Income[]
  expenses       Expense[]
  budgets        Budget[]
  savingsGoals   SavingsGoal[]
  notifications  Notification[]
  insights       Insight[]
  customCategories Category[]   @relation("UserCustomCategories")

  @@index([email])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id         String    @id @default(uuid())
  name       String
  isDefault  Boolean   @default(false)
  userId     String?
  color      String?   @default("#9275F5")
  icon       String?   @default("tag")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User?     @relation("UserCustomCategories", fields: [userId], references: [id], onDelete: Cascade)
  expenses   Expense[]
  budgets    Budget[]

  @@unique([name, userId])
  @@index([userId])
}

model Income {
  id          String             @id @default(uuid())
  userId      String
  source      String
  amount      Decimal            @db.Decimal(12, 2)
  date        DateTime
  description String?
  recurring   RecurringFrequency @default(NONE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Expense {
  id            String             @id @default(uuid())
  userId        String
  categoryId    String
  title         String
  amount        Decimal            @db.Decimal(12, 2)
  date          DateTime
  paymentMethod PaymentMethod      @default(DEBIT_CARD)
  description   String?
  recurring     RecurringFrequency @default(NONE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  receipt       Receipt?

  @@index([userId, date])
  @@index([userId, categoryId])
}

model Receipt {
  id          String     @id @default(uuid())
  expenseId   String?    @unique
  fileUrl     String
  fileKey     String?
  ocrVendor   String?
  ocrDate     DateTime?
  ocrAmount   Decimal?   @db.Decimal(12, 2)
  ocrStatus   OcrStatus  @default(PENDING)
  rawOcrText  String?    @db.Text
  uploadedAt  DateTime   @default(now())

  expense     Expense?   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

model Budget {
  id         String    @id @default(uuid())
  userId     String
  categoryId String?
  month      String    // Format: YYYY-MM
  amount     Decimal   @db.Decimal(12, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, month, categoryId])
  // The initial migration adds a partial unique index for rows with no category.
  @@index([userId, month])
}

model SavingsGoal {
  id           String    @id @default(uuid())
  userId       String
  name         String
  targetAmount Decimal   @db.Decimal(12, 2)
  savedAmount  Decimal   @default(0.00) @db.Decimal(12, 2)
  targetDate   DateTime
  color        String?   @default("#9275F5")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // 'BUDGET_50', 'BUDGET_80', 'BUDGET_100', 'OCR_PROCESSED', 'SYSTEM'
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Insight {
  id        String        @id @default(uuid())
  userId    String
  period    String        // Format: YYYY-MM
  text      String        @db.Text
  source    InsightSource @default(RULE)
  createdAt DateTime      @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, period])
}
